{
    "name": "imranbru99/laravel-session-visual-analytics",
    "description": "SessionVista — real-time Laravel session tracking, device insights, geography analytics, and a premium admin dashboard.",
    "type": "library",
    "keywords": [
        "laravel",
        "session",
        "analytics",
        "dashboard",
        "tracking",
        "device",
        "geo",
        "sessionvista"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Imran Ahmed",
            "email": "me@imrandev.bd",
            "homepage": "https://imrandev.bd",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/imranbru99/laravel-session-visual-analytics",
    "support": {
        "issues": "https://github.com/imranbru99/laravel-session-visual-analytics/issues",
        "source": "https://github.com/imranbru99/laravel-session-visual-analytics",
        "docs": "https://imrandev.bd/contact"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "illuminate/session": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Imranbru99\\SessionVisualAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Imranbru99\\SessionVisualAnalytics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Imranbru99\\SessionVisualAnalytics\\SessionVisualAnalyticsServiceProvider"
            ],
            "aliases": {
                "SessionVista": "Imranbru99\\SessionVisualAnalytics\\Facades\\SessionVista"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
